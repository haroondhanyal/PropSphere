{
  "name": "propsphere",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev --workspace @propsphere/api\" \"npm:dev --workspace @propsphere/web\"",
    "build": "npm run build --workspace @propsphere/api && npm run build --workspace @propsphere/web",
    "db:generate": "npm run db:generate --workspace @propsphere/api",
    "db:migrate": "npm run db:migrate --workspace @propsphere/api",
    "db:seed": "npm run db:seed --workspace @propsphere/api",
    "automation:test": "npm --prefix automation/playwright-automation run test",
    "automation:test:db": "npm --prefix automation/playwright-automation run test:db",
    "automation:test:api": "npm --prefix automation/playwright-automation run test:api",
    "automation:test:bdd": "npm --prefix automation/playwright-automation run test:bdd",
    "automation:test:ui": "npm --prefix automation/playwright-automation run test:ui",
    "automation:test:smoke": "npm --prefix automation/playwright-automation run test:smoke",
    "automation:test:admin": "npm --prefix automation/playwright-automation run test:admin",
    "automation:test:workspace": "npm --prefix automation/playwright-automation run test:workspace",
    "automation:test:public": "npm --prefix automation/playwright-automation run test:public",
    "automation:test:auth": "npm --prefix automation/playwright-automation run test:auth",
    "automation:test:regression": "npm --prefix automation/playwright-automation run test:regression",
    "automation:test:integration": "npm --prefix automation/playwright-automation run test:integration",
    "automation:test:negative": "npm --prefix automation/playwright-automation run test:negative",
    "automation:report": "npm --prefix automation/playwright-automation run report",
    "automation:report:serve": "npm --prefix automation/playwright-automation run report:serve",
    "automation:screenshots": "npm --prefix automation/playwright-automation run report:screenshots",
    "performance:test": "node automation/performance-testing/k6/run-performance.mjs",
    "performance:report": "node automation/performance-testing/k6/render-report.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0"
  }
}
